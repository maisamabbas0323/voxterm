# VoxTerm — example environment file
#
# Copy this file to `.env` in the project root (or next to the packaged app)
# and fill in what you need. VoxTerm loads `.env` at startup; anything you set
# here is picked up automatically.
#
# Credentials given here appear in Settings as already "configured" — you do
# NOT need to paste them into the app. A value entered in the app always wins
# over the environment. Secrets are read only by the main process and are never
# exposed to the renderer.
#
# `.env` is gitignored. Never commit real keys.

# ── Credentials (read by the main process) ────────────────────────────────────

# Google AI Studio (Gemini API) key — powers hosted-Gemma prompt enhancement.
# Accepted aliases: GOOGLE_API_KEY, GEMINI_API_KEY.
VOXTERM_GOOGLE_API_KEY=

# ElevenLabs key — powers speech-to-text (dictation) and spoken announcements.
# Accepted alias: ELEVENLABS_API_KEY.
VOXTERM_ELEVENLABS_API_KEY=

# ── Optional non-secret defaults ──────────────────────────────────────────────
# Used only when the matching value in Settings is still at its default.

# Hosted Gemma model id for Google AI Studio (default: gemma-4-31b-it).
VOXTERM_GOOGLE_MODEL=

# ElevenLabs voice id used for spoken announcements.
VOXTERM_ELEVENLABS_VOICE_ID=

# ElevenLabs text-to-speech model id (default: eleven_multilingual_v2).
VOXTERM_ELEVENLABS_MODEL=

# ── Runtime ───────────────────────────────────────────────────────────────────
# Disables the Chromium SUID sandbox. Only needed in containers/Xvfb where the
# sandbox helper is not configured (e.g. CI). Never use `1` on a normal desktop.
VOXTERM_DISABLE_CHROMIUM_SANDBOX=

# Overrides the dev-server URL used by the renderer during electron-vite dev.
# Managed by the toolchain — only set it if you know why.
ELECTRON_RENDERER_URL=
